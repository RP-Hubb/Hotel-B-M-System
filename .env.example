# ==============================================================================
# ADISHIV LUXURY HOTEL & MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your environment.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=false
APP_NAME="Adishiv Hotel & Suites"
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration (MySQL 8.0.16+ / MariaDB 10.6+ via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adishiv_hotel
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Currency & Localization
APP_CURRENCY_CODE=INR
APP_CURRENCY_SYMBOL=₹
DEFAULT_LANGUAGE=en

# Session Security
SESSION_NAME=ADISHIV_SESS_ID
SESSION_LIFETIME_MINUTES=120
CSRF_TOKEN_KEY=adishiv_csrf_token

# Email Notifications (Optional Future Integration)
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="concierge@adishivhotel.com"
MAIL_FROM_NAME="Adishiv Concierge"

# Anti-Abuse (Optional Cloudflare Turnstile Hook)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
