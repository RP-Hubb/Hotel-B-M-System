# ==============================================================================
# Adishiv Luxury Hotel & Suites - Root Defense-in-Depth .htaccess
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive configuration and source files
    RewriteRule ^(\.env|\.git|\.agents|composer\.|package\.) - [F,L]
    RewriteRule ^(config|database|bin|src|tests)/ - [F,L]
    RewriteRule \.(sql|md|log|ini|sh|bak)$ - [F,L]
</IfModule>

# Block access to sensitive files
<FilesMatch "(\.env|\.sql|\.md|\.log|\.ini|\.git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
